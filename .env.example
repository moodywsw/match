# Prefer app-local env files:
#   apps/mobile/.env.example
#   apps/web/.env.example
#
# Mobile:
#   EXPO_PUBLIC_SUPABASE_URL=
#   EXPO_PUBLIC_SUPABASE_ANON_KEY=
#   EXPO_PUBLIC_REVENUECAT_IOS_KEY=
#   EXPO_PUBLIC_REVENUECAT_ANDROID_KEY=
# Web:
#   VITE_SUPABASE_URL=
#   VITE_SUPABASE_ANON_KEY=
#
# Supabase Edge Function secrets (never in the app; set with `supabase secrets set`):
#   REVENUECAT_WEBHOOK_SECRET=        # same value as RevenueCat webhook Authorization header
#   REVENUECAT_SECRET_API_KEY=        # optional, sk_… — lets TRANSFER events re-sync
