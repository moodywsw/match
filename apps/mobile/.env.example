EXPO_PUBLIC_SUPABASE_ANON_KEY=your_publishable_or_anon_key_here

# After `eas init` (do not invent — paste the real UUID):
EAS_PROJECT_ID=ec207fec-1ece-43a1-b5ef-d4383bc933f3
# EXPO_PUBLIC_EAS_PROJECT_ID=

# Optional Expo account owner username for multi-account orgs:
# EXPO_OWNER=

# Android FCM (path to google-services.json for production builds — never commit):
# GOOGLE_SERVICES_JSON=./google-services.json

# RevenueCat public SDK keys (Project → API keys). Public, safe in the app.
# Empty = purchases disabled (paywall shows, no crash). In Expo Go the SDK runs
# in Preview API Mode (simulated purchases). For EAS builds set these as EAS
# environment variables (eas env:create) instead of committing them.
EXPO_PUBLIC_REVENUECAT_IOS_KEY=
EXPO_PUBLIC_REVENUECAT_ANDROID_KEY=
